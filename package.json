{
  "$schema": "https://raw.githubusercontent.com/vicinaehq/vicinae/refs/heads/main/extra/schemas/extension.json",
  "name": "vicinae-z13ctl",
  "title": "z13ctl",
  "description": "RGB lighting and system control for ROG Flow Z13 2025",
  "categories": ["system"],
  "license": "MIT",
  "author": "elweday1",
  "contributors": [],
  "pastContributors": [],
  "icon": "extension_icon.png",
  "commands": [
    {
      "name": "z13ctl",
      "title": "z13ctl",
      "subtitle": "Status & Quick Actions",
      "description": "System status and quick actions for ROG Flow Z13",
      "mode": "view"
    },
    {
      "name": "z13ctl-lighting",
      "title": "z13ctl-lighting",
      "subtitle": "RGB Lighting Control",
      "description": "Control keyboard and lightbar RGB lighting",
      "mode": "view"
    },
    {
      "name": "z13ctl-lighting-presets",
      "title": "z13ctl-lighting-presets",
      "subtitle": "RGB Presets",
      "description": "Quick RGB lighting presets",
      "mode": "view"
    },
    {
      "name": "z13ctl-power",
      "title": "z13ctl-power",
      "subtitle": "Power & Performance",
      "description": "Performance profile, TDP, battery limit",
      "mode": "view"
    },
    {
      "name": "z13ctl-undervolt",
      "title": "z13ctl-undervolt",
      "subtitle": "CPU Undervolt",
      "description": "CPU Curve Optimizer undervolt control",
      "mode": "view"
    },
    {
      "name": "z13ctl-fans",
      "title": "z13ctl-fans",
      "subtitle": "Fan Curves",
      "description": "View and reset fan curves",
      "mode": "view"
    },
    {
      "name": "z13ctl-fans-edit",
      "title": "z13ctl-fans-edit",
      "subtitle": "Fan Curve Editor",
      "description": "Edit custom 8-point fan curves",
      "mode": "view"
    }
  ],
  "preferences": [],
  "scripts": {
    "build": "vici build",
    "dev": "vici develop"
  },
  "dependencies": {
    "@vicinae/api": "^0.8.2"
  },
  "devDependencies": {
    "typescript": "^5.9.2"
  }
}
